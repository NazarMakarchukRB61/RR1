#include <stdio.h> // Підключення бібліотеки для введення та виведення даних

// [Математичний рівень]
// Обчислення суми елементів квадратної матриці,
// розташованих вище головної діагоналі та на ній.
// Умова вибору елементів: j >= i.
//
// [Алгоритмічний рівень]
// Послідовний перебір рядків та стовпців матриці
// за допомогою двох вкладених циклів.
// Накопичення суми вибраних елементів.
//
// [Програмний рівень]
// Оголошення функції calculateSum типу double,
// яка приймає розмір матриці N та двовимірний масив A.
// Функція повертає обчислену суму елементів.
double calculateSum(int N, double A[N][N]) {

    double sum = 0.0;
    int i, j;

    for (i = 0; i < N; i++) {

        for (j = i; j < N; j++) {

            sum = sum + A[i][j];
        }
    }

    return sum;
}


// [Математичний рівень]
// Введення квадратної матриці та виведення суми
// її елементів, розташованих на головній діагоналі та вище неї.
//
// [Алгоритмічний рівень]
// Введення розміру матриці, заповнення її елементами,
// виведення матриці та виклик функції обчислення суми.
//
// [Програмний рівень]
// Оголошення головної функції main() типу int.
int main() {

    int N = 0;
    int i, j;
    double result;

    printf("Enter matrix size N: ");
    scanf("%d", &N);

    if (N < 1) {
        printf("Error: N must be >= 1\n");
        return 1;
    }

    double A[N][N];

    printf("Enter matrix elements:\n");

    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) {

            scanf("%lf", &A[i][j]);
        }
    }

    printf("\nMatrix A:\n");

    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) {

            printf("%8.2lf", A[i][j]);
        }

        printf("\n");
    }

    result = calculateSum(N, A);

    printf("\nSum of elements = %.2lf\n", result);

    return 0;
}
