#include <stdio.h> // Підключення бібліотеки для введення та виведення даних

// [Математичний рівень]
// Обчислення суми ряду за заданою формулою.
// Початкове значення суми S = 1.
//
// [Алгоритмічний рівень]
// Послідовне обчислення членів ряду від n = 1 до n = N.
// Якщо знаменник дорівнює нулю, поточний член ряду пропускається.
//
// [Програмний рівень]
// Оголошення функції calculateSeriesSum типу double,
// яка приймає дійсне число a та ціле число N.
// Функція повертає обчислену суму ряду.
double calculateSeriesSum(double a, int N) {

    double S = 1.0;
    double power = 1.0;
    double denominator;
    double term;
    int n;

    for (n = 1; n <= N; n++) {

        // Обчислення степеня a^n без використання pow().
        power = power * a;

        // Обчислення знаменника залежно від парності n.
        if (n % 2 != 0) {
            denominator = a + n;
        } else {
            denominator = a - n;
        }

        // Перевірка знаменника на рівність нулю.
        if (denominator == 0.0) {
            continue;
        }

        // Обчислення поточного члена ряду з урахуванням знака.
        if (n % 2 != 0) {
            term = -power / denominator;
        } else {
            term = power / denominator;
        }

        // Додавання поточного члена до загальної суми.
        S = S + term;
    }

    return S;
}


// [Математичний рівень]
// Отримання початкових значень a та N і виведення суми ряду.
//
// [Алгоритмічний рівень]
// Введення даних, перевірка правильності N,
// виклик функції обчислення та виведення результату.
//
// [Програмний рівень]
// Оголошення головної функції main() типу int.
int main() {

    double a = 0.0;
    double result;
    int N = 0;

    printf("Enter a: ");
    scanf("%lf", &a);

    printf("Enter N (N >= 1): ");
    scanf("%d", &N);

    if (N < 1) {
        printf("Error: N must be >= 1\n");
        return 1;
    }

    result = calculateSeriesSum(a, N);

    printf("Sum S = %.6lf\n", result);

    return 0;
}
